# Copy this file to `.env` and fill in values. `.env` is gitignored - NEVER commit it.
# Shell environment variables take priority over values in `.env`.

# Required only for `python -m ragkit.cli ask` (real LLM generation).
OPENAI_API_KEY=

# Optional: any OpenAI-compatible endpoint (university gateway, local gateway, etc.).
# Leave empty to use the provider default.
OPENAI_BASE_URL=

# Set to 1 to enable the real end-to-end pytest (also needs OPENAI_API_KEY).
RUN_REAL_E2E=0

# Optional override for the LLM model chosen in config.toml.
# LLM_MODEL=
