# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- generated artefacts (rebuild locally with `cli ingest`) ---
data/index/*
!data/index/.gitkeep
*.log

# --- experiment outputs ---
# Raw per-item outputs, logs and caches stay local. Reproducible summaries
# (aggregate metrics, charts, config snapshots) ARE committed under
# eval/results/summary/ -- see eval/results/README.md.
eval/results/raw/
eval/results/**/*.log
eval/results/**/*.tmp

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- local scratch (never commit) ---
.tmp/
# eight-character, extension-less scratch files left by local tooling
/[a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_]
